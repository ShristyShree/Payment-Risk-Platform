# Copy this file to .env and fill in real values. Never commit .env itself.

# Port the Express server listens on
PORT=5000

# MongoDB connection string.
# Local:  mongodb://localhost:27017/payment-risk-platform
# Atlas:  mongodb+srv://<username>:<password>@<cluster-url>/payment-risk-platform
MONGODB_URI=mongodb://localhost:27017/payment-risk-platform

# development | production
NODE_ENV=development

# Secret used to sign JWTs. Use a long, random string — never reuse this
# example value in a real .env. e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# How long an issued token stays valid, e.g. 1d, 12h, 30m
JWT_EXPIRES_IN=1d